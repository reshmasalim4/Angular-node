# Copy this file to .env and fill in the values.

# OAuth 2.0 Client ID (Web application) from Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Only Google accounts with an email on this domain may sign in.
ALLOWED_EMAIL_DOMAIN=gmail.com

# Optional: where the SQLite database file is stored.
# DB_PATH=data/app.db
